# Copy this file to .env.local (never commit .env.local).

# PostgreSQL connection string.
# Local:    postgres://clickeat:clickeat@localhost:5432/clickeat
# Supabase: use the "Transaction pooler" URI (port 6543) from Project Settings → Database.
DATABASE_URL=postgres://clickeat:clickeat@localhost:5432/clickeat

# Long random string used to hash IP addresses for rate limiting.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clickeat",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Keep the free address https://clickeat.<account>.workers.dev switched on at every deploy.
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Runs the worker close to the database (Frankfurt) instead of close to each visitor.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  // Database: Hyperdrive config "clickeat-db" → Supabase (Frankfurt, session pooler), caching off.
  // The ID is not a secret; the database password is stored encrypted inside Hyperdrive.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "d407ab6e318a433cab852f6f7031a65d",
      // Used only by `wrangler dev` / `pnpm cf:preview` on a developer machine.
      "localConnectionString": "postgres://clickeat:clickeat@localhost:5432/clickeat"
    }
  ]
  // Secret APP_SECRET is set in the dashboard (Worker → Settings → Variables and secrets).
}
